---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  heroImage?: string;
  pageTitle?: string;
  ogType?: string;
}

const { title, description, eyebrow, heroImage, pageTitle, ogType } = Astro.props;
const headTitle = pageTitle ?? `${title} — Que sais-je?`;
---

<BaseLayout title={headTitle} description={description} image={heroImage} ogType={ogType}>
  <div class="page">
    <header class="page-nav">
      <a class="page-nav__brand" href="/"><span>Que</span> sais-je?</a>
      <nav aria-label="Primary">
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>

    <main class="page-main">
      {
        heroImage && (
          <div class="page-hero">
            <img src={heroImage} alt="" />
          </div>
        )
      }

      <section class="page-head">
        {eyebrow && <div class="page-eyebrow">{eyebrow}</div>}
        <h1 class="page-title">{title}</h1>
        {description && <p class="page-deck">{description}</p>}
      </section>

      <div class="page-body">
        <slot />
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
