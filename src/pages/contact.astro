---
import PageLayout from '../layouts/PageLayout.astro';

const email = import.meta.env.CONTACT_EMAIL;
const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY;
---

<PageLayout
  title="Form"
  eyebrow="Say hello"
  description="Your message lands straight in my inbox."
>
  <div class="prose">
    <p>
    </p>
  </div>

  <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="adachigeorge.com — New contact message" />
    <input type="hidden" name="from_name" value="adachigeorge.com" />
    <!-- honeypot: bots fill this; humans never see it -->
    <input
      type="checkbox"
      name="botcheck"
      tabindex="-1"
      autocomplete="off"
      style="display: none;"
    />

    <label>
      Name
      <input type="text" name="name" required />
    </label>
    <label>
      Email
      <input type="email" name="email" required />
    </label>
    <label>
      Message
      <textarea name="message" required></textarea>
    </label>
    <button type="submit">Send</button>
    <p class="contact-form__status" data-status hidden aria-live="polite"></p>
  </form>
</PageLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const status = form?.querySelector<HTMLParagraphElement>('[data-status]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    if (!status || !button) return;
    event.preventDefault();

    status.hidden = false;
    status.dataset.state = 'sending';
    status.textContent = 'Sending…';
    button.disabled = true;

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form),
      });
      const result = await response.json();

      if (result.success) {
        status.dataset.state = 'ok';
        status.textContent = 'Thanks — your message has been sent.';
        form.reset();
      } else {
        status.dataset.state = 'error';
        status.textContent =
          'Something went wrong. Please use the email link above instead.';
      }
    } catch {
      status.dataset.state = 'error';
      status.textContent = 'Network error. Please use the email link above instead.';
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .contact-form__status {
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  .contact-form__status[data-state='ok'] {
    color: #1a7f37;
  }
  .contact-form__status[data-state='error'] {
    color: #b3261e;
  }
</style>
